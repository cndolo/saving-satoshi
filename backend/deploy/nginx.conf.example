# Replace the domain and certificate paths; include this in Nginx's http context.
server {
    listen 80;
    server_name satoshi.example.edu;
    return 301 https://satoshi.example.edu$request_uri;
}

server {
    listen 443 ssl;
    server_name satoshi.example.edu;
    ssl_certificate /etc/letsencrypt/live/satoshi.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/satoshi.example.edu/privkey.pem;

    # Backend limits JSON requests to 1 MiB as well.
    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";

    # No trailing slash on proxy_pass: /v1/auth/login stays /v1/auth/login.
    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_cache off;
        access_log off;
    }

    # Includes Next.js pages, /_next/ and public assets.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache off;
    }
}
