[Unit]
Description=Saving Satoshi account and progress API
After=network.target

[Service]
Type=simple
User=satoshi
Group=satoshi
WorkingDirectory=/srv/saving-satoshi/backend
EnvironmentFile=/etc/saving-satoshi/backend.env
# Adapt this absolute path to the server's Bundler installation (command -v bundle).
ExecStart=/usr/local/bin/bundle exec puma -C puma.rb config.ru
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
