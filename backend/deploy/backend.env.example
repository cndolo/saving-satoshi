# Install as /etc/saving-satoshi/backend.env; consumed by systemd and CLI shell.
APP_ENV=production
DATABASE_PATH=/var/lib/saving-satoshi/course.sqlite3
BIND=tcp://127.0.0.1:8000
ALLOWED_HOSTS=satoshi.example.edu,localhost,127.0.0.1
ALLOWED_ORIGINS=https://satoshi.example.edu
SESSION_TTL_SECONDS=28800
COURSE_CHAPTER_IDS=1,2,3,8,9,10
# Keep the original sign-up flow; set false for CLI-only provisioning.
ALLOW_REGISTRATION=true
