[Unit]
Description=Saving Satoshi Next.js frontend
After=network.target

[Service]
Type=simple
User=satoshi
Group=satoshi
WorkingDirectory=/srv/saving-satoshi
Environment=NODE_ENV=production
# Adapt this absolute path to the server's Node installation (command -v node).
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
