# Environment files are not auto-loaded. Export these variables in your shell/service.
DATABASE_PATH=./var/course.sqlite3
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,::1
SESSION_TTL_SECONDS=28800
BIND=tcp://127.0.0.1:8000
# Visible chapters in this course; used by the CSV export metric.
COURSE_CHAPTER_IDS=1,2,3,8,9,10
# Keep the original sign-up flow; set false for CLI-only provisioning.
ALLOW_REGISTRATION=true
